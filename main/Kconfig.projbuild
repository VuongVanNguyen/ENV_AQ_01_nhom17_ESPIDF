menu "ENV-AQ-01 Project Configuration"

    menu "WiFi"
        config WIFI_SSID
            string "WiFi SSID"
            default "MySSID"
            help
                SSID của mạng WiFi cần kết nối.

        config WIFI_PASSWORD
            string "WiFi Password"
            default "MyPassword"
            help
                Mật khẩu WiFi.
    endmenu

    menu "MQTT"
        config MQTT_BROKER_URL
            string "MQTT Broker URL"
            default "mqtt://broker.hivemq.com:1883"
            help
                URL của MQTT broker. Ví dụ: mqtt://192.168.1.100:1883

        config MQTT_TOPIC
            string "MQTT Publish Topic"
            default "env/aq01/data"
            help
                Topic để publish dữ liệu cảm biến.

        config MQTT_TOPIC_ALERT
            string "MQTT Alert Topic"
            default "env/aq01/alert"
            help
                Topic để publish cảnh báo (calib_alert, threshold breach).

        config MQTT_TOPIC_CMD
            string "MQTT Command Topic (subscribe)"
            default "env/aq01/cmd"
            help
                Topic broker gửi lệnh xuống thiết bị.
                Payload JSON hỗ trợ: {"cmd":"confirm_calib"}, {"cmd":"reboot"}.
    endmenu

    menu "AQI Category Thresholds (chi so AQI 0-500)"
        config AQI_GOOD_MAX
            int "AQI index max for category Good"
            default 50
            range 0 500

        config AQI_MODERATE_MAX
            int "AQI index max for category Moderate"
            default 100
            range 0 500

        config AQI_POOR_MAX
            int "AQI index max for category Poor"
            default 150
            range 0 500

        config AQI_BAD_MAX
            int "AQI index max for category Bad"
            default 200
            range 0 500

        config AQI_VERY_BAD_MAX
            int "AQI index max for category Very Bad"
            default 300
            range 0 500
    endmenu

    menu "Alert Thresholds"
        config ALERT_CO2_PPM
            int "CO2 WARNING threshold (ppm)"
            default 1000
            range 400 5000
            help
                Ngưỡng CO2 để phát cảnh báo mức WARNING (buzzer/LED).

        config ALERT_CO2_CRITICAL_PPM
            int "CO2 CRITICAL threshold (ppm)"
            default 2000
            range 1000 5000
            help
                Ngưỡng CO2 để phát cảnh báo mức CRITICAL (buzzer/LED).
                Phải >= ALERT_CO2_PPM.
    endmenu

    menu "NTP"
        config NTP_SERVER_URL
            string "NTP Server URL"
            default "pool.ntp.org"
            help
                URL của NTP server để đồng bộ thời gian thực (UTC).
                Ví dụ: pool.ntp.org, vn.pool.ntp.org, time.google.com
    endmenu

    menu "Sensor Timing"
        config SENSOR_READ_INTERVAL_MS
            int "Sensor read interval (ms)"
            default 2000
            range 500 60000
            help
                Chu kỳ đọc cảm biến tính theo milliseconds.

        config DISPLAY_UPDATE_INTERVAL_MS
            int "Display update interval (ms)"
            default 3000
            range 1000 10000
    endmenu

    choice TEST_MODE
        prompt "Sensor Test Mode"
        default TEST_MODE_NONE
        help
            Chọn chế độ test khi đang debug phần cứng từng cảm biến.
            Khi hoàn thiện dự án, chọn "Production (no test)" —
            main.cpp tự động chạy production code, không cần sửa code.

        config TEST_MODE_NONE
            bool "Production (no test)"
        config TEST_MODE_BME680
            bool "BME680 only"
        config TEST_MODE_PMS5003
            bool "PMS5003 only"
        config TEST_MODE_MQ135
            bool "MQ-135 only"
        config TEST_MODE_ALL
            bool "All sensors (via SensorManager)"
    endchoice

endmenu
