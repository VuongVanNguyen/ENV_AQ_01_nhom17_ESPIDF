# ---- Compiler ----
CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_COMPILER_CXX_RTTI=n

# ---- FreeRTOS ----
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_UNICORE=n

# ---- Task Watchdog ----
# 10s thay vì default 5s — chừa biên an toàn cho LCD_MAX_INTERVAL_MS=5000ms
# (config.hpp §6) và storageTask (fsync/rename SD có thể block hàng trăm ms).
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

# ---- Log level ----
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL=3

# ---- WiFi ----
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8

# ---- MQTT ----
CONFIG_MQTT_PROTOCOL_311=y
CONFIG_MQTT_OUTBOX_EXPIRED_TIMEOUT_MS=30000

# ---- NVS ----
CONFIG_NVS_ENCRYPTION=n

# ---- UART ----
CONFIG_UART_ISR_IN_IRAM=y

# ---- ADC ----
CONFIG_ADC_ONESHOT_CTRL_FUNC_IN_IRAM=y

# ---- SD / FAT ----
CONFIG_FAT_USE_FASTSEEK=y
CONFIG_SDMMC_IO_POWER_1800MV=n

# ---- Partition table ----
# Firmware (esp-idf-lib drivers + MQTT + FAT/SD + STL) vượt 1MB factory mặc định
# -> dùng partition "single app large" (factory 1500K) để còn biên tăng trưởng.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# ---- Flash size ----
# Board thực tế dùng module 4MB Flash (xem CLAUDE.md §1); 2MB không đủ chứa
# factory 1500K + nvs + phy_init một cách an toàn cho các board 4MB thực tế.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# ---- Project ----
CONFIG_WIFI_SSID="YourSSID"
CONFIG_WIFI_PASSWORD="YourPassword"
CONFIG_MQTT_BROKER_URL="mqtt://broker.hivemq.com:1883"
CONFIG_MQTT_TOPIC="env/aq01/data"
CONFIG_MQTT_TOPIC_ALERT="env/aq01/alert"
CONFIG_MQTT_TOPIC_CMD="env/aq01/cmd"
CONFIG_NTP_SERVER_URL="pool.ntp.org"
CONFIG_SENSOR_READ_INTERVAL_MS=2000
CONFIG_DISPLAY_UPDATE_INTERVAL_MS=3000
CONFIG_AQI_GOOD_MAX=50
CONFIG_AQI_MODERATE_MAX=100
CONFIG_AQI_POOR_MAX=150
CONFIG_AQI_BAD_MAX=200
CONFIG_AQI_VERY_BAD_MAX=300
CONFIG_ALERT_CO2_PPM=1000
CONFIG_ALERT_CO2_CRITICAL_PPM=2000

