menu "ENV-AQ-01 Project Configuration"

    menu "WiFi"
        config WIFI_SSID
            string "WiFi SSID"
            default "MySSID"
            help
                SSID của mạng WiFi cần kết nối.

        config WIFI_PASSWORD
            string "WiFi Password"
            default "MyPassword"
            help
                Mật khẩu WiFi.

        config WIFI_DNS_BACKUP
            string "Backup DNS server (IPv4)"
            default "8.8.8.8"
            help
                DNS dự phòng, dùng khi DNS chính (do router cấp qua DHCP) không
                phản hồi hoặc bị lỗi — tránh MQTT không kết nối được chỉ vì
                getaddrinfo() không phân giải được hostname broker.
    endmenu

    menu "MQTT"
        config MQTT_BROKER_URL
            string "MQTT Broker URL"
            default "mqtt://broker.hivemq.com:1883"
            help
                URL của MQTT broker. Ví dụ: mqtt://192.168.1.100:1883

        config MQTT_TOPIC
            string "MQTT Publish Topic"
            default "env/aq01/data"
            help
                Topic để publish dữ liệu cảm biến (periodic) VÀ cảnh báo
                (edge-triggered, calib_alert/threshold breach) — 2 luồng
                phân biệt bằng field "msg_type" ("data"/"alert") trong JSON.

        config MQTT_TOPIC_CMD
            string "MQTT Command Topic prefix (subscribe, RPC)"
            default "v1/devices/me/rpc/request"
            help
                Tiền tố topic RPC của ThingsBoard — broker publish lệnh vào
                "<prefix>/<requestId>". Code tự nối "/+" khi subscribe.
                Payload JSON theo chuẩn ThingsBoard: {"method":"confirm_calib","params":{}}.
                Lệnh khác: {"method":"skip_warmup","params":{}} — force *_ready = true toàn
                pipeline (LCD + DataFusion + MQTT dashboard) khi sensor vật lý đã warm nhưng
                timer phần mềm bị reset do rút/cắm điện. Tự tắt khi timer thật hết hạn.

        config MQTT_ACCESS_TOKEN
            string "MQTT Username / Access Token"
            default ""
            help
                Dùng làm username khi kết nối MQTT (ví dụ ThingsBoard Access Token).
                Để trống nếu broker không yêu cầu auth (ví dụ broker.hivemq.com).
    endmenu

    menu "AQI Category Thresholds (chi so AQI 0-500)"
        config AQI_GOOD_MAX
            int "AQI index max for category Good"
            default 50
            range 0 500

        config AQI_MODERATE_MAX
            int "AQI index max for category Moderate"
            default 100
            range 0 500

        config AQI_POOR_MAX
            int "AQI index max for category Poor"
            default 150
            range 0 500

        config AQI_BAD_MAX
            int "AQI index max for category Bad"
            default 200
            range 0 500

        config AQI_VERY_BAD_MAX
            int "AQI index max for category Very Bad"
            default 300
            range 0 500
    endmenu

    menu "Alert Thresholds"
        config ALERT_CO2_PPM
            int "CO2 WARNING threshold (ppm)"
            default 1000
            range 400 5000
            help
                Ngưỡng CO2 để phát cảnh báo mức WARNING (buzzer/LED).

        config ALERT_CO2_CRITICAL_PPM
            int "CO2 CRITICAL threshold (ppm)"
            default 2000
            range 1000 5000
            help
                Ngưỡng CO2 để phát cảnh báo mức CRITICAL (buzzer/LED).
                Phải >= ALERT_CO2_PPM.
    endmenu

    menu "NTP"
        config NTP_SERVER_URL
            string "NTP Server URL"
            default "pool.ntp.org"
            help
                URL của NTP server để đồng bộ thời gian thực (UTC).
                Ví dụ: pool.ntp.org, vn.pool.ntp.org, time.google.com
    endmenu

    menu "Sensor Timing"
        config SENSOR_READ_INTERVAL_MS
            int "Sensor read interval (ms)"
            default 2000
            range 500 60000
            help
                Chu kỳ đọc cảm biến tính theo milliseconds.

        config DISPLAY_UPDATE_INTERVAL_MS
            int "Display update interval (ms)"
            default 3000
            range 1000 10000
    endmenu

    menu "Storage (SD Card)"
        config SD_LOG_INTERVAL_MS
            int "Periodic data log interval (ms)"
            default 30000
            range 5000 300000
            help
                Chu ky ghi 1 dong CSV vao airdata.csv (StorageHelper.hpp Sec3.1).
                Nen la boi so cua Sensor read interval.
    endmenu

endmenu
