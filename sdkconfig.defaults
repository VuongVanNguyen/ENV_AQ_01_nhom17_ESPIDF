# ---- Compiler ----
CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_COMPILER_CXX_RTTI=n

# ---- FreeRTOS ----
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_UNICORE=n

# ---- Log level ----
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL=3

# ---- WiFi ----
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8

# ---- MQTT ----
CONFIG_MQTT_PROTOCOL_311=y
CONFIG_MQTT_OUTBOX_EXPIRED_TIMEOUT_MS=30000

# ---- NVS ----
CONFIG_NVS_ENCRYPTION=n

# ---- UART ----
CONFIG_UART_ISR_IN_IRAM=y

# ---- ADC ----
CONFIG_ADC_ONESHOT_CTRL_FUNC_IN_IRAM=y

# ---- SD / FAT ----
CONFIG_FAT_USE_FASTSEEK=y
CONFIG_SDMMC_IO_POWER_1800MV=n

# ---- Project ----
CONFIG_WIFI_SSID="YourSSID"
CONFIG_WIFI_PASSWORD="YourPassword"
CONFIG_MQTT_BROKER_URL="mqtt://broker.hivemq.com:1883"
CONFIG_MQTT_TOPIC="env/aq01/data"
CONFIG_MQTT_TOPIC_ALERT="env/aq01/alert"
CONFIG_SENSOR_READ_INTERVAL_MS=2000
CONFIG_DISPLAY_UPDATE_INTERVAL_MS=3000
